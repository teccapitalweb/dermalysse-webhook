# Stripe
STRIPE_SECRET_KEY=PEGA_AQUI_LA_CLAVE_SECRETA_DE_STRIPE
STRIPE_WEBHOOK_SECRET=PEGA_AQUI_EL_SECRETO_DEL_WEBHOOK_DE_STRIPE

# Firebase Admin: JSON completo del service account en una sola línea
FIREBASE_SERVICE_ACCOUNT=PEGA_AQUI_EL_JSON_DE_FIREBASE_ADMIN

# Bunny Stream: valores de la biblioteca de Dermalysse
BUNNY_STREAM_LIBRARY_ID=PEGA_AQUI_EL_ID_DE_LA_BIBLIOTECA
BUNNY_STREAM_API_KEY=PEGA_AQUI_LA_API_KEY_DE_LA_BIBLIOTECA
BUNNY_STREAM_CDN_HOSTNAME=PEGA_AQUI_EL_HOSTNAME_CDN

# Opcional: si Bunny muestra una clave separada para autenticación del reproductor.
# Si se omite, el backend usa BUNNY_STREAM_API_KEY para firmar el embed.
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_TOKEN_TTL_SECONDS=300

# EmailJS (opcionales; si faltan, los correos se omiten sin afectar pagos o videos)
ADMIN_EMAIL=correo_administrativo@example.com
EMAILJS_SERVICE_ID=PEGA_AQUI_EL_SERVICE_ID
EMAILJS_TEMPLATE_ID=PEGA_AQUI_EL_TEMPLATE_ID
EMAILJS_PUBLIC_KEY=PEGA_AQUI_LA_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=PEGA_AQUI_LA_PRIVATE_KEY

PORT=3000
